# One ignore file for every chapter. A pattern without a slash inside it matches at any
# depth, so these rules cover subfolders too. Lock files stay tracked on purpose.

# Python bytecode and caches
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Python build and packaging output
build/
dist/
*.egg-info/
.eggs/

# Test coverage
.coverage
.coverage.*
coverage.xml
htmlcov/

# Virtual environments
.venv/
venv/
env/

# Dependencies that deploy.py stages for the AgentCore code zip
.build/
**/.build/
01-simple-strands-harness/.build/

# AWS CDK and AWS SAM output
cdk.out/
cdk.context.json
.aws-sam/

# Editor and operating system files
.DS_Store
.idea/
.vscode/
*.swp

# Local agent task state and Kiro tool settings
.seed_task_id
.kiro/

# Code that cli.py downloads from a work item
05-software-factory/out/

# Your Agent Space settings for chapter 02. Copy devops.env.example to start.
02-devops-harness/devops.env

# Strands Box binaries: downloaded (macOS) or built (Linux), never committed
bin-macos/
bin-linux/
03-strands-box-harness/download.sh
